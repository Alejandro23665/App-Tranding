# =============================================================================
# CONFIGURACIÓN DE ENTORNO - SISTEMA DE MONITOREO DE CRIPTOMONEDAS
# =============================================================================
# Copia este archivo a .env y completa los valores según tu configuración
# NUNCA subas el archivo .env real a control de versiones (git)
# =============================================================================

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DJANGO
# -----------------------------------------------------------------------------

# Clave secreta de Django (OBLIGATORIA en producción)
# Genera una nueva con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-cambia-esta-clave-en-produccion

# Modo debug (True/False) - SIEMPRE False en producción
DJANGO_DEBUG=True

# Hosts permitidos (separados por comas)
# En producción: tu-dominio.com,www.tu-dominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# CONFIGURACIÓN BINANCE API
# -----------------------------------------------------------------------------

# API Key de Binance (obtenida en https://www.binance.com/es/my/settings/api-management)
# Para datos públicos (ticker, precios) NO es obligatoria, pero recomendada para rate limits más altos
BINANCE_API_KEY=

# API Secret de Binance (NUNCA la compartas)
# Requerida solo para endpoints privados (cuenta, trading, etc.)
BINANCE_API_SECRET=

# -----------------------------------------------------------------------------
# CONFIGURACIÓN GEMINI AI
# -----------------------------------------------------------------------------

# API Key de Gemini (obtenida en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# CONFIGURACIÓN OPCIONAL AVANZADA
# -----------------------------------------------------------------------------

# Timeout para peticiones a Binance (segundos)
# BINANCE_REQUEST_TIMEOUT=10

# Ventana de recepción para firmas (milisegundos)
# BINANCE_RECV_WINDOW=5000

# Puerto del servidor de desarrollo (por defecto 8000)
# PORT=8000