# =============================================================================
# CONFIGURACIÓN DE DEBUG TEMPORAL PARA VERCEL
# =============================================================================
# Copia este archivo como .env en Vercel para activar DEBUG temporalmente
# =============================================================================

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DJANGO - DEBUG TEMPORAL
# -----------------------------------------------------------------------------

# Clave secreta de Django (OBLIGATORIA en producción)
# Genera una nueva con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-production-secret-key-here

# FORZAR DEBUG=True TEMPORALMENTE PARA VER ERRORES EN VERCEL
# Una vez identificado el error, vuelve a poner False
DJANGO_DEBUG=True

# Hosts permitidos (separados por comas)
# En producción: tu-dominio.vercel.app,www.tu-dominio.com
ALLOWED_HOSTS=*.vercel.app,localhost,127.0.0.1

# -----------------------------------------------------------------------------
# CONFIGURACIÓN BINANCE API
# -----------------------------------------------------------------------------

# API Key de Binance (obtenida en https://www.binance.com/es/my/settings/api-management)
# Para datos públicos (ticker, precios) NO es obligatoria, pero recomendada para rate limits más altos
BINANCE_API_KEY=your-binance-api-key

# API Secret de Binance (NUNCA la compartas)
# Requerida solo para endpoints privados (cuenta, trading, etc.)
BINANCE_API_SECRET=your-binance-api-secret

# -----------------------------------------------------------------------------
# CONFIGURACIÓN GEMINI AI
# -----------------------------------------------------------------------------

# API Key de Gemini (obtenida en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL recomendado para producción)
# -----------------------------------------------------------------------------
# Para Vercel, usa una base de datos externa como Neon, Supabase, PlanetScale, etc.
# DATABASE_URL=postgresql://user:password@host:port/database