{
  "version": 2,
  "builds": [
    {
      "src": "crypto_monitor/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "crypto_monitor/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "crypto_monitor.settings",
    "PYTHONPATH": "."
  }
}