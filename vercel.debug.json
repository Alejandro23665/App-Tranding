# =============================================================================
# VERCEL DEBUG DEPLOYMENT CONFIGURATION
# =============================================================================
# Copia este archivo como vercel.json en la raíz del proyecto para deploy con DEBUG
# =============================================================================

{
  "version": 2,
  "buildCommand": "pip install -r requirements.txt && python manage.py collectstatic --noinput",
  "devCommand": "python manage.py runserver",
  "installCommand": "pip install -r requirements.txt",
  "framework": "python",
  "regions": ["iad1"],
  "functions": {
    "crypto_monitor/wsgi.py": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "crypto_monitor/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "crypto_monitor.settings",
    "PYTHONPATH": ".",
    "DJANGO_DEBUG": "True",
    "ALLOWED_HOSTS": "*.vercel.app,localhost,127.0.0.1"
  }
}